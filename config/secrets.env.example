# Mẫu cho config/secrets.env — copy thành config/secrets.env rồi điền giá trị thật.
# config/secrets.env đã được gitignore; file .example này thì được commit.
# Trong YAML tham chiếu bằng ${TÊN}, ví dụ:  password: ${EXCHANGE_PG_PASSWORD}
# Biến môi trường thật cùng tên được ưu tiên hơn giá trị trong file.

# Telegram alert bot (tạo qua @BotFather)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Pipeline market_trades (mật khẩu mặc định của stack Docker trong docker-compose.yml)
EXCHANGE_PG_PASSWORD=password123
ANALYTICS_CH_PASSWORD=clickhouse123
